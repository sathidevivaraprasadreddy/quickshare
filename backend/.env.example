# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL / TiDB Serverless / Aiven)
# For local XAMPP:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quickshare_db
# Or full connection URL (e.g., mysql://user:pass@host:port/dbname?ssl={"rejectUnauthorized":true})
DATABASE_URL=

# Storage Configuration: 'local' (development) or 's3' (production Cloudflare R2 / Supabase / AWS S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3 Compatible Storage (Cloudflare R2, Supabase Storage, Backblaze B2, AWS S3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=quickshare-files

# Security Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_COUNT=10
DEFAULT_EXPIRY_HOURS=24
CLEANUP_CRON_SCHEDULE=*/15 * * * *
